          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/vocabulary": {
      "get": {
        "summary": "Get Vocabulary",
        "operationId": "get_vocabulary_vocabulary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VocabularyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Get Categories",
        "operationId": "get_categories_categories_get",
        "responses": {
          "200": {
            "description": "Successful Response",
