                  "learn_sign": "#/components/schemas/LearnSign",
                  "match_pairs": "#/components/schemas/MatchPairs",
                  "sign_to_word": "#/components/schemas/SignToWord",
                  "word_to_sign": "#/components/schemas/WordToSign"
