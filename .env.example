# Copie para `.env` (o compose lê sozinho) só se quiser mudar algo. Sem este arquivo valem os padrões abaixo.

# --- Máquina limpa: o que o Airflow faz sozinho na primeira subida ---------------------------------------------
# `completo`: corpus todo (127 mil frases) e treino completo (HORAS; precisa de bastante CPU e memória).
# `demo`: amostra de 3.000 frases e treino rápido (MINUTOS); o modelo sai pior, só serve para demonstrar o fluxo.
SINALIZA_PERFIL=completo
# `false` desliga o disparo automático (rode os DAGs à mão no Airflow, http://localhost:8080).
SINALIZA_AUTO_PIPELINE=true

# --- API e privacidade ---------------------------------------------------------------------------------------------
# `false`: a API não carrega o modelo (só a lista fixa); use em Docker com pouca memória.
SINALIZA_USE_MODEL=true
# O texto digitado pode ter dado pessoal. `true` grava texto e palavras de todas as origens; só ligue depois de
# haver aviso de privacidade na interface. O simulador de uso sempre tem o texto gravado (frases públicas).
SINALIZA_LOG_TEXT=false
# Dias até o DAG `monitoramento` apagar o texto das inferências já processadas (os indicadores ficam).
SINALIZA_RETENCAO_DIAS=30

# --- Infraestrutura --------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=sinaliza
POSTGRES_PORT=5432
# Pasta com o motions.npz (derivado do V-LIBRASIL, fora do repositório). Sem ele a API usa o aceno de teste.
# SINALIZA_MOTIONS_DIR=C:\caminho\para\Datasets\motions
